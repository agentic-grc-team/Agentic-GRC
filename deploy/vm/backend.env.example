# /etc/agentic-grc/backend.env on the app VM (root:agrc, mode 640). Never commit real values.
DB_HOST=db-agentic-grc
DB_PORT=5432
DB_NAME=agentic_grc
DB_USER=agentic_grc
DB_PASSWORD=
DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public URL behind the university reverse proxy (no trailing slash).
APP_BASE_URL=https://gita.udea.edu.co/agentic-grc
# Beta: production blocks interviews until the data-policy gates are approved and requires SMTP.
APP_ENVIRONMENT=development
ALLOW_DEMO_REPORT=false
INTERVIEW_DATA_MODE=synthetic

AGRC_OLLAMA_HOST=http://127.0.0.1:11434
AGRC_LLM_MODEL=llama3.1:8b
# Tesla M10 (Vulkan): ~19 s per call p50, ~37 s p95. With the default 8 s almost every call
# falls back to keywords.
AGRC_LLM_TIMEOUT_S=40
AGRC_LLM_RETRIES=1
AGRC_LLM_KEEP_ALIVE=24h
AGRC_LLM_NUM_PREDICT=320
AGRC_MAX_FOLLOW_UPS=3

# Outbound SMTP is blocked from the VM: Beta accounts are created by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
