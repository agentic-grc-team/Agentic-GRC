# /etc/systemd/system/ollama.service on the app VM.
# Ollama build with Vulkan, running llama3.1:8b on the Tesla M10.
[Unit]
Description=Ollama (llama3.1:8b, Vulkan on Tesla M10)
After=network-online.target
Wants=network-online.target

[Service]
User=ollama
Group=ollama
SupplementaryGroups=video render
Environment=HOME=/var/lib/ollama
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/ollama/models
# Never unload the model: the M10 is dedicated to it, and a reload makes the next turn time out.
Environment=OLLAMA_KEEP_ALIVE=-1
Environment=CUDA_VISIBLE_DEVICES=-1
# Add here any other variable the Vulkan build needs.
ExecStart=/opt/ollama/bin/ollama serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
