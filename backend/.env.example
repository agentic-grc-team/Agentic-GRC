# Copy this file to .env and replace the placeholders with the PostgreSQL
# connection values provided for your environment. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agentic_grc
DB_USER=replace_with_postgres_user
DB_PASSWORD=replace_with_postgres_password
DB_SSLMODE=prefer

# Supabase Auth. Keep the secret key on the backend only; never use it in VITE_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public frontend URL used in account activation emails.
APP_BASE_URL=http://127.0.0.1:4178
APP_ENVIRONMENT=development

# Serve the sample demo report (local demos only). Must stay false in production.
ALLOW_DEMO_REPORT=false
# Interview data gate. Keep synthetic data as the default. Real data stays blocked until every
# transfer, retention, deletion, redaction, storage, and topology decision is approved.
INTERVIEW_DATA_MODE=synthetic
INTERVIEW_ANONYMIZED_DATA_APPROVED=false
INTERVIEW_EXTERNAL_TRANSFER_APPROVED=false
INTERVIEW_RETENTION_APPROVED=false
INTERVIEW_DELETION_APPROVED=false
INTERVIEW_REDACTION_APPROVED=false
INTERVIEW_STORAGE_APPROVED=false
INTERVIEW_TOPOLOGY_DOCUMENTED=false

# Local development runtime for the single interview agent. Use only with synthetic
# data unless the interview data-policy gates above have been approved.
AGRC_OLLAMA_HOST=http://127.0.0.1:11434
AGRC_LLM_MODEL=llama3.1:8b
AGRC_LLM_TIMEOUT_S=8
AGRC_LLM_RETRIES=1
# Keep the model loaded between turns, and cap generated tokens (docs/ollama-setup.md)
AGRC_LLM_KEEP_ALIVE=30m
AGRC_LLM_NUM_PREDICT=320
AGRC_MAX_FOLLOW_UPS=3

# SMTP settings used to send organization invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
