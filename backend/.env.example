# Copy this file to .env and replace the placeholders with the PostgreSQL
# connection values provided for your environment. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agentic_grc
DB_USER=replace_with_postgres_user
DB_PASSWORD=replace_with_postgres_password
DB_SSLMODE=prefer

# Local email/password authentication. Generate a unique random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=agentic-grc
JWT_AUDIENCE=agentic-grc-api
JWT_ACCESS_TOKEN_MINUTES=30

# Public frontend URL used in account activation emails.
APP_BASE_URL=http://127.0.0.1:4178
APP_ENVIRONMENT=development

# SMTP settings used to send organization invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
