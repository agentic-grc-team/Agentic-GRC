# Copy this file to .env and replace the placeholders with the PostgreSQL
# connection values provided for your environment. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agentic_grc
DB_USER=replace_with_postgres_user
DB_PASSWORD=replace_with_postgres_password
DB_SSLMODE=prefer

# OpenID Connect / JWT validation (the API fails closed until these are set).
AUTH_ISSUER=https://identity-provider.example/tenant
AUTH_AUDIENCE=agentic-grc-api
AUTH_JWKS_URL=https://identity-provider.example/tenant/.well-known/jwks.json
